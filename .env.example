# Tapo P115 LAN IP: reserve this IP in Fritz!Box DHCP settings
TAPO_IP=10.10.0.50
# TP-Link/Tapo account used to pair the plug (never sent to frontend)
TAPO_USERNAME=your-tapo-account@example.com
TAPO_PASSWORD=replace-me

# Protects the dashboard (choose a DIFFERENT password from your Tapo login)
DASH_USER=admin
DASH_PASSWORD=replace-with-a-long-unique-password

HTTP_HOST=0.0.0.0
HTTP_PORT=8766
POLL_SECONDS=10
# Refuse OFF while desk load exceeds this threshold. Set conservatively
OFF_MAX_WATTS=30
# Estimated cost per kilowatt-hour in EUR
EUR_PER_KWH=0.30
