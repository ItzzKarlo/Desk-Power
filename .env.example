# Reserve both P115 IPs in Fritz!Box; format stable-id@ip,stable-id@ip
# IDs must be lowercase. The displayed names come from the Tapo app
TAPO_PLUGS=zeus@10.10.0.50,monitors@10.10.0.51

# Both devices must be paired under this same Tapo account
TAPO_USERNAME=your-tapo-account@example.com
TAPO_PASSWORD=replace-me

# Dashboard login; independent from your Tapo account
DASH_USER=admin
DASH_PASSWORD=replace-with-a-long-unique-password

HTTP_HOST=0.0.0.0
HTTP_PORT=8766
POLL_SECONDS=10
# Refuse to turn OFF an individual plug while its load exceeds this threshold
OFF_MAX_WATTS=30
EUR_PER_KWH=0.30
